---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { sitePath } from "../lib/url";

interface Props {
  author: CollectionEntry<"team">;
}

const { author } = Astro.props;
const { name, role, bio, credentials, photo, slug } = author.data;
---

<section
  aria-labelledby="author-bio-heading"
  class="card mt-12 max-w-prose overflow-hidden"
>
  <div class="card-header border-b border-line">
    <h2 id="author-bio-heading" class="m-0 text-small text-ink">
      About the author
    </h2>
  </div>
  <div class="card-body flex flex-col gap-4 sm:flex-row sm:items-start">
    <Image
      src={photo}
      alt={`Photo of ${name}`}
      width={120}
      height={120}
      loading="lazy"
      class="h-[120px] w-[120px] shrink-0 rounded-xl border border-line object-cover"
    />
    <div class="min-w-0">
      <p class="m-0 text-small text-ink">
        <a href={sitePath(`/team/#${slug}`)} class="link-body">{name}</a>
        {" · "}
        <span class="text-muted">{role}</span>
      </p>
      {
        credentials && (
          <p class="mt-2 mb-0 text-small text-muted">{credentials}</p>
        )
      }
      <p class="mt-3 mb-0 text-body text-secondary">{bio}</p>
    </div>
  </div>
</section>
