---
import { SITE_NAME } from "../config/site";
import { sitePath, absoluteUrl } from "../lib/url";

const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/services/", label: "Services" },
  { href: "/articles/", label: "Articles" },
  { href: "/team/", label: "Team" },
  { href: "/testimonials/", label: "Testimonials" },
  { href: "/contact/", label: "Contact" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/terms/", label: "Terms" },
];
---

<footer class="mt-16 border-t border-line bg-background">
  <div
    class="shell flex flex-col gap-3 py-6 text-small text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="m-0">
      &copy; {new Date().getFullYear()}
      {" "}
      {SITE_NAME}
    </p>
    <nav aria-label="Footer">
      <ul class="m-0 flex list-none flex-wrap items-center gap-1 p-0">
        {
          links.map((link) => (
            <li>
              <a href={sitePath(link.href)} class="nav-item">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={absoluteUrl("/rss.xml")} class="nav-item">RSS</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
