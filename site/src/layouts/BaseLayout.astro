---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME, SITE_URL, SAME_AS, CONTACT_EMAIL } from "../config/site";
import { absoluteUrl } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  robots?: string;
  locale?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Absolute URL to the final optimized static asset (from getImage()). */
  ogImageUrl?: string;
  twitterCard?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonicalPath,
  robots = "index, follow",
  locale = "en-US",
  ogTitle,
  ogDescription,
  ogImageUrl,
  twitterCard = "summary_large_image",
  ogType = "website",
} = Astro.props;

if (!title) {
  throw new Error("BaseLayout requires a unique title prop.");
}
if (!description) {
  throw new Error("BaseLayout requires a unique description prop.");
}
if (!canonicalPath) {
  throw new Error("BaseLayout requires a canonicalPath prop.");
}

const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;
const canonical = /^https?:\/\//i.test(canonicalPath)
  ? canonicalPath
  : absoluteUrl(canonicalPath);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: SITE_URL.endsWith("/") ? SITE_URL : `${SITE_URL}/`,
  sameAs: SAME_AS,
  email: CONTACT_EMAIL,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={absoluteUrl("/rss.xml")}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans text-body text-ink antialiased">
    <Header />
    <main class="shell flex-1 py-10 md:py-14">
      <slot />
    </main>
    <Footer />
  </body>
</html>
