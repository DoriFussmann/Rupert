---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";
import { sitePath } from "../../lib/url";

const title = `Terms of Service — ${SITE_NAME}`;
const description =
  "Terms of Service for Rupert. Placeholder page pending final legal language from counsel or a template service.";
---

<BaseLayout title={title} description={description} canonicalPath="/terms/">
  <section aria-labelledby="terms-heading" class="max-w-prose">
    <h1 id="terms-heading" class="m-0 text-h1 text-ink">Terms of Service</h1>
    <div
      class="mt-8 flex min-h-40 items-center justify-center rounded-xl border border-dashed border-line bg-soft px-4 py-8 text-center text-small text-muted"
      role="note"
    >
      [PLACEHOLDER: Replace with real Terms of Service from legal counsel or a
      template service]
    </div>
    <p class="mt-8 mb-0 text-small text-muted">
      Questions in the meantime:
      {" "}
      <a href={sitePath("/contact/")} class="link-body">Contact</a>.
    </p>
  </section>
</BaseLayout>
