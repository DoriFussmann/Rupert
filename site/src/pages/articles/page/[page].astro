---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { sitePath } from "../../../lib/url";

export async function getStaticPaths() {
  const pageSize = 6;
  const all = (await getCollection("articles"))
    .filter((a) => !a.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  const totalPages = Math.ceil(all.length / pageSize);
  // Pages 2+ only; page 1 lives at /articles/
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const pageNum = i + 2;
    const start = (pageNum - 1) * pageSize;
    return {
      params: { page: String(pageNum) },
      props: {
        articles: all.slice(start, start + pageSize),
        page: pageNum,
        totalPages: Math.max(1, totalPages),
      },
    };
  });
}

const { articles, page, totalPages } = Astro.props;

const title = `Articles — Page ${page}`;
const description = `Browse published articles, page ${page} of ${totalPages}.`;
const canonicalPath = `/articles/page/${page}/`;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <section aria-labelledby="articles-heading">
    <h1 id="articles-heading" class="m-0 mb-8 text-h1 text-ink">
      Articles
    </h1>
    <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <li class="card overflow-hidden">
            <a
              href={sitePath(`/articles/${article.data.slug}/`)}
              class="block no-underline"
            >
              <Image
                src={article.data.image}
                alt={article.data.imageAlt}
                width={320}
                height={180}
                loading="lazy"
                class="aspect-video w-full border-b border-line object-cover"
              />
              <div class="card-header">
                <h2 class="m-0 text-small text-ink">{article.data.title}</h2>
              </div>
            </a>
            <div class="card-body border-t border-line">
              <p class="m-0 text-small text-secondary">
                {article.data.description}
              </p>
              <p class="mt-3 mb-0 text-small text-muted">
                <time datetime={article.data.date.toISOString()}>
                  {article.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    timeZone: "UTC",
                  })}
                </time>
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <nav aria-label="Pagination" class="mt-10">
      <ol class="m-0 flex list-none flex-wrap items-center gap-1 p-0">
        {
          Array.from({ length: totalPages }, (_, i) => {
            const n = i + 1;
            const href =
              n === 1
                ? sitePath("/articles/")
                : sitePath(`/articles/page/${n}/`);
            return (
              <li>
                {n === page ? (
                  <span
                    aria-current="page"
                    class="nav-item border-line bg-soft text-ink"
                  >
                    {n}
                  </span>
                ) : (
                  <a href={href} class="nav-item border-line">
                    {n}
                  </a>
                )}
              </li>
            );
          })
        }
      </ol>
    </nav>
  </section>
</BaseLayout>
