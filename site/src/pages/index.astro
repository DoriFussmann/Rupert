---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME } from "../config/site";
import { sitePath } from "../lib/url";

const howItWorks = [
  "We research your ideal investors",
  "We run personalized outreach on your behalf",
  "You own every conversation and every relationship.",
];

const services = (await getCollection("services"))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const articles = (await getCollection("articles"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const title = `${SITE_NAME} — Home`;
const description =
  "Rupert helps founders connect with the investors most likely to fund their companies. Every outreach campaign is researched, personalized, and managed by experienced operators, while founders retain complete visibility, every conversation, and every investor relationship.";
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <section aria-labelledby="intro-heading" class="max-w-prose">
    <h1 id="intro-heading" class="m-0 text-display text-ink">
      {SITE_NAME}
    </h1>
    <p class="mt-4 mb-0 max-w-prose text-body text-secondary">
      Rupert helps founders connect with the investors most likely to fund their
      companies. Every outreach campaign is researched, personalized, and managed
      by experienced operators, while founders retain complete visibility, every
      conversation, and every investor relationship.
    </p>
  </section>

  <section aria-labelledby="how-it-works-heading" class="mt-16">
    <h2 id="how-it-works-heading" class="m-0 mb-6 text-h2 text-ink">
      How It Works
    </h2>
    <ol class="m-0 grid list-none gap-3 p-0 md:grid-cols-2 lg:grid-cols-3">
      {
        howItWorks.map((step, index) => (
          <li class="card">
            <div class="card-header border-b border-line">
              <h3 class="m-0 text-small text-ink">
                <span class="text-muted">{index + 1}.</span> {step}
              </h3>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="services-heading" class="mt-16">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="services-heading" class="m-0 text-h2 text-ink">Services</h2>
      <a href={sitePath("/services/")} class="link-body text-small">
        View all services
      </a>
    </div>
    {
      services.length === 0 ? (
        <p class="m-0 text-body text-muted">No services published yet.</p>
      ) : (
        <ul class="m-0 flex list-none flex-col gap-3 p-0">
          {services.map((service) => (
            <li class="card overflow-hidden">
              <a
                href={sitePath(`/services/#${service.data.slug}`)}
                class="card-header flex min-h-11 flex-col gap-1 no-underline"
              >
                <span class="text-small text-ink">{service.data.title}</span>
              </a>
              <div class="card-body border-t border-line">
                <p class="m-0 text-small text-secondary">{service.data.summary}</p>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section aria-labelledby="latest-heading" class="mt-16">
    <h2 id="latest-heading" class="m-0 mb-6 text-h2 text-ink">
      Latest Articles
    </h2>
    {
      articles.length === 0 ? (
        <p class="m-0 text-body text-muted">No articles published yet.</p>
      ) : (
        <ul class="m-0 flex list-none flex-col gap-2 p-0">
          {articles.map((article) => (
            <li class="card overflow-hidden">
              <a
                href={sitePath(`/articles/${article.data.slug}/`)}
                class="card-header flex min-h-11 flex-col gap-1 no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
              >
                <span class="text-small text-ink">{article.data.title}</span>
                <span class="shrink-0 text-small text-muted">
                  {article.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                    timeZone: "UTC",
                  })}
                </span>
              </a>
              <div class="card-body border-t border-line">
                <p class="m-0 text-small text-secondary">
                  {article.data.description}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section aria-labelledby="cta-heading" class="mt-16">
    <div class="card overflow-hidden">
      <div class="card-body max-w-prose">
        <h2 id="cta-heading" class="m-0 text-h2 text-ink">
          Start a conversation
        </h2>
        <p class="mt-3 mb-0 text-body text-secondary">
          If you are raising and want researched, personalized investor outreach
          managed on your behalf — with every relationship remaining yours —
          get in touch.
        </p>
        <p class="mt-6 mb-0">
          <a href={sitePath("/contact/")} class="btn">Contact</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
